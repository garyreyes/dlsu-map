{
  "name": "dlsu-map",
  "private": true,
  "version": "0.0.0",
  "description": "DLSU 3D Campus Navigator: an offline-first 3D map of De La Salle University (Manila) that routes students to any room. Student project, not an official DLSU app.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run compile-data && vite",
    "build": "npm run compile-data && vite build && node scripts/check-size.mjs",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check . && markdownlint-cli2 \"**/*.md\"",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -b",
    "test": "vitest run",
    "format": "prettier --write .",
    "prepare": "husky",
    "e2e": "playwright test",
    "icons": "node scripts/render-icons.mjs",
    "fetch-osm": "node scripts/fetch-osm.ts",
    "compile-data": "node scripts/compile-data.ts",
    "floor-extract": "node tools/floor-extract/cli.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,css,html,yml,yaml}": "prettier --write",
    "*.md": "markdownlint-cli2"
  },
  "dependencies": {
    "@react-three/drei": "~10.7.9",
    "@react-three/fiber": "~9.8.2",
    "lucide-react": "^1.52.0",
    "motion": "^12.43.0",
    "ngraph.graph": "^20.1.2",
    "ngraph.path": "^1.6.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-modal-sheet": "^5.6.0",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "4.152.0"
  }
}
